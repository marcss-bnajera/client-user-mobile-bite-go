# ============================================================================
# Bite&Go Mobile (Usuario) - Variables de entorno
# ============================================================================
# Copia este archivo a `.env` y rellena los valores reales.
# Estas variables son públicas (EXPO_PUBLIC_*) y se empaquetan en el build.
# ============================================================================

# URL del auth-service (.NET) — para login/registro
EXPO_PUBLIC_AUTH_URL=http://localhost:3000/api/v1/auth

# URL del user-service (Node.js) — para restaurantes, pedidos, etc.
EXPO_PUBLIC_USER_URL=http://localhost:3001/bite-and-go/v1
